# Google Sheet that holds Member Information, the weekly task tabs, and the attendance log
SHEET_ID=

# Service account key (share the sheet with its client_email as Editor)
SERVICE_ACCOUNT_FILE=service_account.json
# ...or paste the whole JSON on one line instead (handy for hosting):
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Long random string, e.g.  python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# Officers who can start/end meetings and see the code. Names exactly as in Member Information,
# comma separated, e.g.  ADMIN_NAMES=Jason,James
ADMIN_NAMES=

TIMEZONE=America/Chicago
LOG_TAB=Attendance Log

# Tab with the Name and PIN columns (kept separate from Member Information).
LOGINS_TAB=Logins
# Optional: put the logins in a totally separate spreadsheet file instead (share it with the service account).
# LOGINS_SHEET_ID=

# Sandbox account for looking around. Pick "Demo" on the login screen and enter this PIN.
# Nothing is saved to your sheet. Leave blank to disable.
DEMO_PIN=0000

# Optional extra proof-of-presence: only accept check-ins from your meeting room's public IP.
# Find it by visiting https://ifconfig.me while on that Wi-Fi.
ALLOWED_IPS=
# Set true only if the app runs behind a proxy/host that sets X-Forwarded-For
TRUST_PROXY=false

CODE_STEP_SECONDS=30

# Tab holding hours logged by hand before the app (columns headed with dates like 10/21). Defaults to Member Information.
# PAST_HOURS_TAB=
